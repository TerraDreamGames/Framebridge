          "behavior": {
            "rules": [
              {
                "id": "purchase",
                "branches": [
                  {
                    "when": {
                      "mode": "all",
                      "predicates": [
                        {
                          "source": "leaderstats",
                          "key": "Coins",
                          "operator": "gte",
                          "value": 100
                        },
                        {
                          "source": "attribute",
                          "key": "Ready",
                          "operator": "eq",
                          "value": true
                        }
                      ]
                    },
                    "then": [
                      {
                        "target": "buy",
                        "property": "Interactable",
                        "value": true
                      },
                      {
                        "target": "status",
                        "property": "Text",
                        "value": "Buy <b>now</b>"
                      },
                      {
                        "target": "status",
                        "property": "TextColor3",
                        "value": {
                          "type": "Color3",
                          "value": [
                            0.2,
                            1,
                            0.4
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "when": {
                      "mode": "all",
                      "predicates": [
                        {
                          "source": "leaderstats",
                          "key": "Coins",
                          "operator": "exists"
                        }
                      ]
                    },
                    "then": [
                      {
                        "target": "buy",
                        "property": "Interactable",
                        "value": false
                      },
                      {
                        "target": "status",
                        "property": "Text",
                        "value": "Earn more coins"
                      },
                      {
                        "target": "status",
                        "property": "TextColor3",
                        "value": {
                          "type": "Color3",
                          "value": [
                            1,
                            0.8,
                            0.2
                          ]
                        }
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "target": "buy",
                    "property": "Interactable",
                    "value": false
                  },
                  {
                    "target": "status",
                    "property": "Text",
                    "value": "Awaiting player data"
                  },
                  {
                    "target": "status",
                    "property": "TextColor3",
                    "value": {
                      "type": "Color3",
                      "value": [
                        0.7,
                        0.7,
                        0.7
                      ]
                    }
                  }
                ]
              },
              {
                "id": "premium",
                "branches": [
                  {
                    "when": {
                      "mode": "all",
                      "predicates": [
                        {
                          "source": "attribute",
                          "key": "VIP",
                          "operator": "eq",
                          "value": true
                        }
                      ]
                    },
                    "then": [
                      {
                        "target": "premium",
                        "property": "Visible",
                        "value": true
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "target": "premium",
                    "property": "Visible",
                    "value": false
                  }
                ]
              },
              {
                "id": "compact",
                "branches": [
                  {
                    "when": {
                      "mode": "all",
                      "predicates": [
                        {
                          "source": "viewport",
                          "key": "width",
                          "operator": "lt",
                          "value": 600
                        }
                      ]
                    },
                    "then": [
                      {
                        "target": "compact",
                        "property": "Visible",
                        "value": true
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "target": "compact",
                    "property": "Visible",
                    "value": false
                  }
                ]
              },
              {
                "id": "reward",
                "branches": [
                  {
                    "when": {
                      "mode": "any",
                      "predicates": [
                        {
                          "source": "attribute",
                          "key": "Ready",
                          "operator": "eq",
                          "value": true
                        },
                        {
                          "source": "leaderstats",
                          "key": "Coins",
                          "operator": "gte",
                          "value": 200
                        }
                      ]
                    },
                    "then": [
                      {
                        "target": "status",
                        "property": "BackgroundTransparency",
                        "value": 0.25
                      }
                    ]
                  }
                ]
              }
            ]
          }
