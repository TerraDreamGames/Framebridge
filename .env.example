# Public build configuration only. Never put credentials here.
# Leaving these unset keeps the connected default in framebridge.config.json.
# FRAMEBRIDGE_RELAY_URL=https://your-relay.your-subdomain.workers.dev
# FRAMEBRIDGE_PRIVATE_BETA=0
# FIGMA_PLUGIN_ID=your-figma-assigned-plugin-id
# Build scripts use exported shell variables; Vite reads only public prefixes.
# Server-only development secrets belong in ignored .dev.vars instead.
