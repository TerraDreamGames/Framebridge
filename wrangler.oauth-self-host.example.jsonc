{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framebridge-oauth-callback",
  "main": "packages/relay/cloudflare/oauth-gateway.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://framebridge.example.com/oauth/roblox/*",
      "zone_name": "example.com",
    },
  ],
  "vars": {
    "FRAMEBRIDGE_RELAY_ORIGIN": "https://your-relay.your-subdomain.workers.dev",
    "ROBLOX_OAUTH_REDIRECT_URI": "https://framebridge.example.com/oauth/roblox/callback",
  },
  "observability": { "enabled": false },
}
