{
  "name": "figma-to-rblx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dashboard": "node scripts/operations-dashboard.mjs serve",
    "dashboard:setup": "node scripts/operations-dashboard.mjs setup",
    "build": "npm run licenses:check && tsc --noEmit && node scripts/build.mjs",
    "build:offline": "npm run licenses:check && tsc --noEmit && node scripts/build.mjs --offline",
    "build:local": "npm run licenses:check && tsc --noEmit && node scripts/build.mjs --local",
    "studio:prepare": "node scripts/build-studio.mjs --prepare",
    "studio:build": "node scripts/build-studio.mjs",
    "studio:serve": "node scripts/build-studio.mjs --serve",
    "test:studio:package": "npm run studio:build && lune run scripts/test-studio-package.luau",
    "helper:install": "node scripts/install-local-helper.mjs",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run --exclude '**/.artifacts/**' --exclude '**/prototypes/**' --maxWorkers=2 --testTimeout=15000",
    "benchmark:analysis:native": "node scripts/benchmark-native-analysis.mjs",
    "test:studio": "npm run fixtures && lune run scripts/test-studio.luau",
    "test:models": "tsx scripts/model-export-fixtures.ts && lune run scripts/test-model-export.luau && python3 scripts/check-model-xml.py",
    "check": "npm run test && npm run build && npm run check:figma-library",
    "check:figma-library": "node scripts/figma-library.mjs --check",
    "fixtures": "tsx scripts/fixtures.ts && tsx scripts/class-tools-fixtures.ts",
    "relay": "tsx packages/relay/src/main.ts",
    "dev:connected": "VITE_FRAMEBRIDGE_RELAY_URL=http://127.0.0.1:4318 vite --host 127.0.0.1",
    "build:figma-library": "npm run licenses:check && tsc --noEmit && node scripts/figma-library.mjs",
    "examples:layouts": "tsx scripts/layout-examples.ts",
    "beta:dev": "wrangler dev",
    "beta:invite": "node scripts/private-beta.mjs invite",
    "beta:revoke": "node scripts/private-beta.mjs revoke",
    "beta:access": "node scripts/private-beta.mjs access",
    "beta:deploy": "node scripts/private-beta.mjs deploy",
    "beta:release": "node scripts/private-beta.mjs release",
    "beta:smoke": "node scripts/private-beta.mjs smoke",
    "beta:dry-run": "wrangler deploy --dry-run --outdir .artifacts/cloudflare-dry-run",
    "beta:oauth:dry-run": "wrangler deploy --config wrangler.oauth-gateway.jsonc --dry-run --outdir .artifacts/oauth-gateway-dry-run",
    "beta:reports": "node scripts/feedback-reports.mjs",
    "release:deploy": "node scripts/public-release.mjs deploy",
    "release:package": "node scripts/public-release.mjs package",
    "release:smoke": "node scripts/public-release.mjs smoke",
    "licenses:update": "node scripts/dependency-notices.mjs --write",
    "licenses:check": "node scripts/dependency-notices.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "assets:glyphs": "tsx scripts/export-glyph-assets.ts",
    "assets:glyphs:check": "tsx scripts/export-glyph-assets.ts --check",
    "demo:build": "node scripts/build-website-demo.mjs",
    "media:import": "node scripts/import-website-screenshots.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-png": "8.0.0",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "preact": "^11.0.0",
    "prismjs": "1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@figma/plugin-typings": "^1.117.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/prismjs": "1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "5.20261110.0-beta",
    "pngjs": "7.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  }
}
