{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "framebridge-relay",
  "main": "packages/relay/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": { "binding": "FRAMEBRIDGE_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayRoom" }],
    "code_update_strategy": { "mode": "immediate" },
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "vars": {
    "ACCESS_MODE": "public",
    "MAX_SESSIONS": "200",
    "MAX_ROBLOX_ACCOUNTS": "1000",
    "MAX_ROBLOX_LOGINS": "1000",
    "DAILY_REQUESTS": "25000",
    "DAILY_TRANSFERS": "1000",
    "DAILY_UPLOADS": "2000",
    "DAILY_UPLOADS_PER_CLIENT": "500",
    "VISION_ENABLED": "0",
  },
  "observability": { "enabled": false },
}
