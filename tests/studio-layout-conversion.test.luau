-- Exercise compiled Figma layouts with Roblox's real layout engine. The widget
-- is temporary and no import is applied to the place or persisted as a setting.
local Http = game:GetService("HttpService")
local packages = Http:JSONDecode(fixtures)
local native = PluginManager():CreatePlugin()
local widget = native:CreateDockWidgetPluginGuiAsync("FramebridgeLayoutConversionQA",
    DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, true, 650, 450, 400, 400))
widget.Enabled = true
local stages, passed, failures = {}, 0, {}
local function near(actual, expected)
    assert(math.abs(actual - expected) <= 1, tostring(actual) .. " ~= " .. tostring(expected))
end
local function item(s, id) return assert(s.byId[id], "Missing " .. id).instance end
local function test(name, mode, body)
    local host = Instance.new("Frame")
    host.Size = UDim2.fromOffset(400,400)
    host.BackgroundTransparency = 1
    host.Parent = widget
    local ok, why = pcall(function()
        local package = Importer.decode(Http:JSONEncode(packages[name]))
        local prepared = Editor.prepare(package, {mode = mode})
        local s = Importer.stage(prepared, {}, false)
        table.insert(stages,s)
        item(s,"canvas").Parent = host
        task.wait(.2)
        body(s,host)
    end)
    host:Destroy()
    if ok then passed += 1 else table.insert(failures, name .. " (" .. mode .. "): " .. tostring(why)) end
end
local function resized(panel, w, h)
    panel.Size = UDim2.fromOffset(w,h)
    task.wait(.2)
end
for _, mode in ipairs({"source","scale","offset"}) do
    test("scrollingHug",mode,function(s)
        local panel,content=item(s,"panel"),item(s,"panel/content")
        assert(content.AutomaticSize==Enum.AutomaticSize.XY)
        near(content.AbsoluteSize.X,120)
        local width=panel.AbsoluteSize.X
        local extra=item(s,"cell0"):Clone(); extra.Size=UDim2.fromOffset(160,30); extra.LayoutOrder=5; extra.Parent=content
        task.wait(.2)
        assert(panel.AbsoluteCanvasSize.Y>=210,"Canvas axis was lost when combining Hug and scrolling")
        assert(panel.AbsoluteSize.X>width+50,"Hug did not follow content width")
        extra:Destroy(); task.wait(.2)
        near(content.AbsoluteSize.X,120)
    end)
    test("textHug",mode,function(s)
        local panel,label=item(s,"panel"),item(s,"label")
        local original=panel.AbsoluteSize.Y
        assert(label.AutomaticSize==Enum.AutomaticSize.Y and label.TextWrapped and not label.TextScaled)
        near(label.AbsoluteSize.X,280)
        resized(panel,150,0)
        assert(panel.AbsoluteSize.Y>original,"Hug did not follow wrapped text")
        local wrapped=panel.AbsoluteSize.Y
        label.Text="Short"; task.wait(.2)
        assert(panel.AbsoluteSize.Y<wrapped,"Hug did not shrink after changing live text")
    end)
    test("decoratedHug",mode,function(s)
        local panel,content=item(s,"panel"),item(s,"panel/content")
        near(panel.AbsoluteSize.X,128); near(panel.AbsoluteSize.Y,66)
        local extra=Instance.new("Frame"); extra.Size=UDim2.fromOffset(160,40); extra.LayoutOrder=3; extra.Parent=content
        task.wait(.2)
        near(panel.AbsoluteSize.X,168); near(panel.AbsoluteSize.Y,114)
        extra:Destroy(); task.wait(.2)
        near(panel.AbsoluteSize.X,128); near(panel.AbsoluteSize.Y,66)
    end)
    test("crossFill",mode,function(s)
        local panel=item(s,"panel")
        near(item(s,"stretch").AbsoluteSize.X,280)
        resized(panel,450,160)
        near(item(s,"stretch").AbsoluteSize.X,430)
    end)
    test("rasterSlot",mode,function(s)
        local slot,art=item(s,"art/slot"),item(s,"art")
        near(slot.AbsoluteSize.X,80); near(slot.AbsoluteSize.Y,20)
        near(art.AbsoluteSize.X,88); near(art.AbsoluteSize.Y,32)
        near(art.AbsolutePosition.X-slot.AbsolutePosition.X,-4)
        near(art.AbsolutePosition.Y-slot.AbsolutePosition.Y,-6)
        near(item(s,"next").AbsolutePosition.X-slot.AbsolutePosition.X,90)
    end)
    test("flex",mode,function(s,host)
        local panel = item(s,"panel")
        near(panel.AbsoluteSize.X,300)
        near(item(s,"fixed").AbsoluteSize.X,40)
        near(item(s,"grow1").AbsoluteSize.X,220/3)
        near(item(s,"grow2").AbsoluteSize.X,440/3)
        resized(panel,450,60)
        near(item(s,"fixed").AbsoluteSize.X,40)
        near(item(s,"grow1").AbsoluteSize.X,370/3)
        near(item(s,"grow2").AbsoluteSize.X,740/3)
    end)
    test("hug",mode,function(s)
        local panel = item(s,"panel")
        near(panel.AbsoluteSize.X,128); near(panel.AbsoluteSize.Y,66)
        local extra = Instance.new("Frame")
        extra.Size = UDim2.fromOffset(160,40); extra.LayoutOrder = 3; extra.Parent = panel
        task.wait(.2)
        near(panel.AbsoluteSize.X,168); near(panel.AbsoluteSize.Y,114)
        extra:Destroy(); task.wait(.2)
        near(panel.AbsoluteSize.X,128); near(panel.AbsoluteSize.Y,66)
    end)
    test("wrap",mode,function(s)
        local panel = item(s,"panel")
        near(item(s,"cell0").AbsoluteSize.X,60)
        near(item(s,"cell3").AbsolutePosition.Y-item(s,"cell0").AbsolutePosition.Y,42)
        resized(panel,160,150)
        near(item(s,"cell0").AbsoluteSize.X,60)
        near(item(s,"cell2").AbsolutePosition.Y-item(s,"cell0").AbsolutePosition.Y,42)
        near(item(s,"cell4").AbsolutePosition.Y-item(s,"cell0").AbsolutePosition.Y,84)
    end)
    test("variable",mode,function(s)
        local panel = item(s,"panel")
        assert(item(s,"panel/layout").Wraps)
        near(item(s,"first").AbsoluteSize.X,80)
        assert(item(s,"third").AbsolutePosition.Y > item(s,"first").AbsolutePosition.Y + 20)
        resized(panel,300,150)
        near(item(s,"third").AbsolutePosition.Y,item(s,"first").AbsolutePosition.Y)
        near(item(s,"fourth").AbsoluteSize.X,100)
    end)
    test("absolute",mode,function(s)
        local panel = item(s,"panel")
        assert(item(s,"badge").Parent == item(s,"panel/absolute"))
        near(item(s,"badge").AbsolutePosition.Y-panel.AbsolutePosition.Y,250)
        near(panel.AbsoluteSize.Y,66)
        item(s,"second"):Destroy(); task.wait(.2)
        near(panel.AbsoluteSize.Y,28)
        near(item(s,"badge").AbsolutePosition.Y-panel.AbsolutePosition.Y,250)
    end)
    test("grid",mode,function(s)
        local panel = item(s,"panel")
        near(item(s,"cell0").AbsoluteSize.X,260/3)
        near(item(s,"cell0").AbsoluteSize.Y,50)
        near(item(s,"cell3").AbsolutePosition.Y-item(s,"cell0").AbsolutePosition.Y,58)
        resized(panel,450,200)
        near(item(s,"cell0").AbsoluteSize.X,410/3)
        near(item(s,"cell0").AbsoluteSize.Y,50)
    end)
    test("scroll",mode,function(s)
        local panel = item(s,"panel")
        assert(panel:IsA("ScrollingFrame") and panel.AutomaticCanvasSize == Enum.AutomaticSize.Y)
        assert(panel.AbsoluteCanvasSize.Y >= 80)
        local extra = item(s,"cell0"):Clone()
        extra.LayoutOrder = 6; extra.Parent = panel; task.wait(.2)
        assert(panel.AbsoluteCanvasSize.Y >= extra.AbsolutePosition.Y-panel.AbsolutePosition.Y+extra.AbsoluteSize.Y,
            "New final row is beyond the canvas")
        resized(panel,160,80)
        assert(panel.AbsoluteCanvasSize.Y >= 150, "Grid did not gain rows after narrowing")
        panel.CanvasPosition = Vector2.new(0,100000); task.wait(.2)
        assert(extra.AbsolutePosition.Y+extra.AbsoluteSize.Y <= panel.AbsolutePosition.Y+panel.AbsoluteSize.Y+1,
            "Final card cannot be reached by scrolling")
    end)
    test("decoratedScroll",mode,function(s)
        local panel, content = item(s,"panel"),item(s,"panel/content")
        assert(item(s,"cell0").Parent == content)
        assert(item(s,"panel/fill:0").Parent == panel)
        assert(panel.AbsoluteCanvasSize.Y >= 170, "Decorative content holder blocked canvas growth")
        local extra = item(s,"cell0"):Clone()
        extra.LayoutOrder = 5; extra.Parent = content; task.wait(.2)
        assert(panel.AbsoluteCanvasSize.Y >= 210, "Canvas did not grow after runtime insert")
        extra:Destroy(); task.wait(.2)
        assert(panel.AbsoluteCanvasSize.Y < 210, "Canvas did not shrink after removal")
    end)
end
local destination=Instance.new("Folder")
local updated,updateWhy=pcall(function()
    local package=Importer.decode(Http:JSONEncode(packages.absolute))
    local effective=Editor.prepare(package,{mode="scale"})
    local first=Importer.stage(effective,{},false); table.insert(stages,first)
    local roots=Importer.apply(first,effective,destination,false)
    local panel=roots[1]:FindFirstChild("Canvas"):FindFirstChild("Hug with overlay")
    local overlay=panel:FindFirstChild("Absolute")
    local badge=overlay:FindFirstChild("badge")
    local custom=Instance.new("LocalScript"); custom.Name="UserBehavior"; custom.Parent=badge
    local source=Editor.find(package,"second")
    source.properties.Size={type="UDim2",value={0,160,0,40}}
    effective=Editor.prepare(package,{mode="scale"})
    local nextStage=Importer.stage(effective,{},false); table.insert(stages,nextStage)
    local result=Importer.apply(nextStage,effective,destination,true)
    assert(result[1]==roots[1] and result[1].Canvas:FindFirstChild("Hug with overlay")==panel)
    assert(panel.Absolute==overlay and overlay.badge==badge and custom.Parent==badge)
    assert(panel.Flow.second.Size==UDim2.fromOffset(160,40))
end)
destination:Destroy()
if updated then passed+=1 else table.insert(failures,"Nested layout reimport: " .. tostring(updateWhy)) end
local overlayGui
local visible,visibleWhy=pcall(function()
    local package=Importer.decode(Http:JSONEncode(packages.absolute))
    local s=Importer.stage(package,{},false); table.insert(stages,s)
    overlayGui=s.roots[1]
    overlayGui.Parent=game:GetService("CoreGui")
    task.wait(.2)
    local badge, panel=item(s,"badge"),item(s,"panel")
    near(panel.AbsoluteSize.Y,66)
    assert(badge.AbsolutePosition.Y>panel.AbsolutePosition.Y+panel.AbsoluteSize.Y)
    local point=badge.AbsolutePosition+Vector2.new(3,3)
    local hit=false
    for _,object in ipairs(game:GetService("CoreGui"):GetGuiObjectsAtPosition(point.X,point.Y)) do
        if object==badge then hit=true end
    end
    assert(hit,"Absolute overflow is clipped or cannot receive input")
end)
if overlayGui then overlayGui:Destroy() end
if visible then passed+=1 else table.insert(failures,"Absolute overflow/input: " .. tostring(visibleWhy)) end
for _, s in ipairs(stages) do pcall(Importer.destroy,s) end
widget:Destroy(); native:Destroy()
return {passed=passed,failed=#failures,failures=failures,scope="Compiled layouts mounted in a temporary widget; Source, Scale and Pixels; resizing and runtime additions/removals; no place/settings changed"}
